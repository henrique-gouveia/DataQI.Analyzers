<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Version>0.1.0</Version>
    <Authors>Henrique Gouveia</Authors>
    <Description>Roslyn completion provider that suggests DataQI query-method names (FindBy...) for repositories built on DataQI.Commons 4.0.</Description>
    <Copyright>(c) Henrique Gouveia</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/henrique-gouveia/DataQI.Analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Data Query Interface Analyzers Completion</PackageTags>
    <PackageProjectUrl>https://github.com/henrique-gouveia/DataQI.Analyzers</PackageProjectUrl>
    <Product />
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.8.0" PrivateAssets="all" />
    <!-- Override Roslyn's vulnerable System.Text.Json 7.0.3 in the build dependency graph (CVE-2024-30105). -->
    <PackageReference Include="System.Text.Json" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
